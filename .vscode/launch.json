{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AirTrack: start (calibrate, then control)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/start.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "AirTrack: start (dry run, never moves the cursor)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/start.py",
      "args": ["--dry-run"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "AirTrack: recalibrate",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/start.py",
      "args": ["--recalibrate"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "AirTrack: calibrate (simulated hand, no camera)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/start.py",
      "args": ["--simulate"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
