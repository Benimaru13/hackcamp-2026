# Copy this file to .env and fill in your values:
#
#   copy .env.example .env          (PowerShell)
#
# .env is git-ignored, so the real key never reaches the repository.
# A real environment variable of the same name still takes precedence.

# Required, used only by generate_sounds.py (the app itself never calls the API).
# Create one at https://elevenlabs.io -> Profile -> API keys
ELEVENLABS_API_KEY=sk_d6b589b88959843d229f111623f46914419b7e98b2119395

# Optional. Leave as-is for the default voice, or list the ones your account has:
#   .\.venv\Scripts\python.exe generate_sounds.py --list-voices
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
